# --- Database ---
# Postgres (dipakai demo & produksi prototype). Contoh:
# postgresql+psycopg://signyal:signyal@localhost:5432/signyal
DATABASE_URL=sqlite:///./signyal.db
POSTGRES_USER=signyal
POSTGRES_PASSWORD=signyal
POSTGRES_DB=signyal

# --- AI (Person 2) ---
# Pilih salah satu provider. analyze() fallback ke heuristic bila kosong.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Key tambahan dipakai bergilir (round-robin); key yang kuotanya habis dilewati otomatis.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# AI_PROVIDER: kosong = otomatis (openrouter > gemini bila ada key, else heuristic).
# Isi 'heuristic' untuk paksa mode tanpa LLM (dipakai tests).
AI_PROVIDER=
AI_MODEL_VERSION=heuristic-0.1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Collector Instagram (Person 1) ---
# Daftar di https://www.socialcrawl.dev, isi key di .env (jangan commit).
SOCIALCRAWL_API_KEY=
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev/v1

# --- Utas & komentar (Person 1 / Person 3) ---
# Threads: posting per akun yang balasannya diambil (1 credit per posting), dan batas request.
THREADS_REPLIES_PER_ACCOUNT=2
THREADS_REPLIES_MAX_POSTS=4
# Instagram: komentar teratas HANYA untuk posting yang sudah dinilai relevan (5 credit per posting).
IG_COMMENTS_MAX_POSTS=3
IG_COMMENTS_TOP_N=5
# Jendela kesegaran posting: berapa hari terakhir yang diterima (agar filter tanggal di web ada isi).
# Menambah angka ini tidak menambah credit — satu halaman profile/posts sudah memuat beberapa hari.
COLLECT_FRESH_DAYS=3
# Demo ulang data hari lalu: paksa tanggal snapshot (kosong = hari ini / snapshot terbaru bila offline).
SNAPSHOT_DATE=
